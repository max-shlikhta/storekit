# Copy to apps/api/.env. These values match docker-compose.yml.
HOST=127.0.0.1
PORT=38491
DATABASE_URL=postgres://storekit:storekit@127.0.0.1:54329/storekit_dev
# Tests drop and recreate this database: its name must end with _test.
TEST_DATABASE_URL=postgres://storekit:storekit@127.0.0.1:54329/storekit_test
# At least 32 characters; generate with: openssl rand -hex 32
AUTH_SECRET=change-me-generate-a-long-random-secret
ADMIN_URL=http://localhost:38490
