{
  "name": "@storekit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx scripts/prepare-test-db.ts && node --import tsx --import ./test/setup-env.ts --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migration:new": "tsx scripts/new-migration.ts",
    "db:seed": "tsx scripts/seed.ts",
    "user:create": "tsx scripts/create-user.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "pg-connection-string": "^2.14.1",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.5",
    "typescript": "~6.0.3"
  }
}
